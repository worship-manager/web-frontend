---
import { Tick } from "@components/ui/icons";
import Link from "@components/ui/link.astro";

const { plan } = Astro.props;
const hasDiscount = typeof plan.price === "object";
const currentPrice = hasDiscount ? plan.price.sale : plan.price;
const originalPrice = hasDiscount ? plan.price.original : null;
---

<article
  class:list={[
    "relative flex h-full flex-col rounded-2xl border bg-white p-6 transition duration-200 hover:-translate-y-1 hover:shadow-xl hover:shadow-slate-900/5 sm:p-7",
    plan.popular ? "border-slate-950 shadow-lg shadow-slate-900/10" : "border-slate-200",
  ]}>
  {
    plan.popular && (
      <span class="absolute right-5 top-0 -translate-y-1/2 rounded-full bg-blue-600 px-3 py-1 text-xs font-semibold text-white shadow-sm">
        Best value
      </span>
    )
  }

  <div>
    <p class="text-sm font-semibold uppercase tracking-wider text-blue-600">{plan.eyebrow}</p>
    <h2 class="mt-2 text-2xl font-bold text-slate-950">{plan.name}</h2>
    <p class="mt-2 min-h-[3rem] text-sm leading-6 text-slate-600">{plan.description}</p>
  </div>

  <div class="mt-6 flex min-h-[4.5rem] items-end gap-2 border-b border-slate-100 pb-6">
    <span class="text-4xl font-bold tracking-tight text-slate-950">{currentPrice}</span>
    {plan.priceSuffix && <span class="mb-1 text-sm text-slate-500">{plan.priceSuffix}</span>}
    {
      originalPrice && (
        <span class="mb-1 ml-auto text-sm font-medium text-slate-400 line-through">
          {originalPrice}
        </span>
      )
    }
  </div>

  <ul class="mt-6 grid flex-1 gap-y-4 text-left">
    {
      plan.features.map((item) => (
        <li class="flex items-start gap-3 text-sm text-slate-700">
          <Tick class="h-5 w-5 shrink-0 text-emerald-600" />
          <span>{item}</span>
        </li>
      ))
    }
  </ul>

  <div class="mt-8 flex justify-center">
    <Link
      href={plan.button.link}
      style={plan.popular ? "primary" : "outline"}
      class="min-w-[12rem] font-semibold">
      {plan.button.text}
    </Link>
  </div>
  {plan.note && <p class="mt-3 text-center text-xs text-slate-500">{plan.note}</p>}
</article>
