---
import Container from "@components/container.astro";
import PricingCard from "@components/pricing.astro";
import Link from "@components/ui/link.astro";
import Layout from "@layouts/Layout.astro";

const pricing = [
  {
    eyebrow: "Try it first",
    name: "Free Demo",
    description: "Explore Worship Manager on one device before choosing a license.",
    price: "Free",
    priceSuffix: "forever",
    popular: false,
    features: ["Lifetime free access", "Use on one device", "Community support"],
    button: {
      text: "Download free demo",
      link: "/download",
    },
    note: "No payment details required",
  },
  {
    eyebrow: "Flexible",
    name: "Monthly License",
    description: "Full access with the flexibility of a monthly subscription.",
    price: {
      sale: "$10",
      original: "$12",
    },
    priceSuffix: "/ month",
    popular: false,
    features: ["Everything in the free demo", "Use on up to 5 devices", "Priority support"],
    button: {
      text: "Choose monthly",
      link: `/auth/login?redirect=${encodeURIComponent("/buy?plan=monthly")}`,
    },
    note: "Sign in required to purchase",
  },
  {
    eyebrow: "Save $20",
    name: "Yearly License",
    description: "The best value for churches using Worship Manager year-round.",
    price: {
      sale: "$100",
      original: "$120",
    },
    priceSuffix: "/ year",
    popular: true,
    features: ["Everything in the free demo", "Use on up to 5 devices", "Priority support"],
    button: {
      text: "Choose yearly",
      link: `/auth/login?redirect=${encodeURIComponent("/buy?plan=yearly")}`,
    },
    note: "Sign in required to purchase",
  },
];
---

<Layout title="Pricing">
  <main>
    <section class="relative isolate overflow-hidden border-y border-slate-100 bg-slate-50/70">
      <div
        aria-hidden="true"
        class="absolute left-1/2 top-0 -z-10 h-72 w-72 -translate-x-1/2 rounded-full bg-blue-100/70 blur-3xl">
      </div>
      <Container class="py-16 text-center sm:py-20">
        <p class="text-sm font-semibold uppercase tracking-wider text-blue-600">Simple pricing</p>
        <h1 class="mx-auto mt-3 max-w-3xl text-4xl font-bold tracking-tight text-slate-950 sm:text-5xl">
          Start free, then choose what fits your church.
        </h1>
        <p class="mx-auto mt-5 max-w-2xl text-lg leading-8 text-slate-600">
          Download the free demo today. Upgrade when you need more devices and priority support—no
          complicated tiers or hidden fees.
        </p>
        <div class="mt-8 flex flex-col justify-center gap-3 sm:flex-row">
          <Link href="/download" class="font-semibold">Download free demo</Link>
          <a
            href="#plans"
            class="rounded px-5 py-2.5 text-center font-semibold text-slate-700 transition hover:bg-slate-200/70 focus-visible:ring-2 focus-visible:ring-slate-300">
            Compare plans
          </a>
        </div>
        <p class="mt-4 text-sm text-slate-500">Available for Windows and Linux</p>
      </Container>
    </section>

    <Container class="py-16 sm:py-20">
      <section id="plans" aria-labelledby="plans-heading" class="scroll-mt-8">
        <div class="text-center">
          <h2 id="plans-heading" class="text-3xl font-bold tracking-tight text-slate-950">
            Choose your plan
          </h2>
          <p class="mt-3 text-slate-600">Every option starts with the same easy-to-use desktop app.</p>
        </div>

        <div class="mx-auto mt-12 grid max-w-6xl gap-6 md:grid-cols-3">
          {pricing.map((item) => <PricingCard plan={item} />)}
        </div>
      </section>

      <section
        aria-labelledby="already-licensed-heading"
        class="mx-auto mt-16 flex max-w-6xl flex-col items-center justify-between gap-6 rounded-2xl bg-slate-950 px-6 py-8 text-center sm:px-10 md:flex-row md:text-left">
        <div>
          <h2 id="already-licensed-heading" class="text-2xl font-bold text-white">
            Already have a license?
          </h2>
          <p class="mt-2 text-slate-300">
            Download the app, install it on your computer, and sign in to get started.
          </p>
        </div>
        <Link href="/download" style="inverted" class="shrink-0 font-semibold">
          Go to downloads
        </Link>
      </section>
    </Container>
  </main>
</Layout>
